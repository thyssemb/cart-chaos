{
  "name": "@cart-chaos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:socket.io",
    "start": "CART_STATIC=1 node dist/index.js"
  },
  "dependencies": {
    "@cart-chaos/shared": "*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
